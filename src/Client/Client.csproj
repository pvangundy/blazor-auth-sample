<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RootNamespace>Client</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.1" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Authentication.WebAssembly.Msal" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <Target Name="TailwindInstall" BeforeTargets="Build" Condition=" '$(RunTailwind)' == '' Or '$(RunTailwind)' == 'true' ">
    <Message Text="Restoring npm packages for TailwindCSS" Importance="High" />
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="TailwindBuild" BeforeTargets="Build" DependsOnTargets="TailwindInstall" Condition=" '$(RunTailwind)' == '' Or '$(RunTailwind)' == 'true' ">
    <Message Text="Building TailwindCSS" Importance="High" />
    <Exec Command="npm run tailwind:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
