@page "/"

<section class="space-y-6">
    <header class="space-y-1">
        <h1 class="text-3xl font-semibold text-gray-900">Welcome back</h1>
        <p class="text-gray-500">Your day at a glance.</p>
    </header>

    <article class="bg-iosPrimary text-white rounded-3xl p-6 shadow-ios">
        <h2 class="text-lg font-medium">Today's Highlight</h2>
        <p class="text-sm text-white/80 mt-2">Stay hydrated and plan for mild showers this afternoon.</p>
    </article>

    <article class="grid grid-cols-2 gap-3">
        <div class="bg-white rounded-3xl p-4 shadow-ios">
            <h3 class="text-xs uppercase text-gray-400">Next Event</h3>
            <p class="text-lg font-semibold text-gray-900">Weather briefing</p>
            <p class="text-sm text-gray-500">Today · 4:30 PM</p>
        </div>
        <div class="bg-white rounded-3xl p-4 shadow-ios">
            <h3 class="text-xs uppercase text-gray-400">Conditions</h3>
            <p class="text-lg font-semibold text-gray-900">Cloudy</p>
            <p class="text-sm text-gray-500">Humidity 82%</p>
        </div>
    </article>
</section>
