@using BlazorAuthSample.Shared

<li class="bg-white rounded-3xl shadow-ios px-5 py-4 flex items-center justify-between">
    <div class="space-y-1">
        <p class="text-sm text-gray-500">@Forecast.Date.ToString("dddd")</p>
        <p class="text-lg font-semibold text-gray-900">@Forecast.Summary</p>
    </div>
    <div class="text-right">
        <p class="text-2xl font-semibold text-gray-900">@Forecast.TemperatureC&deg;</p>
        <p class="text-xs text-gray-400">Feels like @Forecast.TemperatureF&deg;</p>
    </div>
</li>

@code {
    [Parameter]
    public WeatherForecastDto Forecast { get; set; } = default!;
}
