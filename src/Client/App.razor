<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layouts.MainLayout)">
                <Authorizing>
                    <Layouts.LoadingScreen />
                </Authorizing>
                <NotAuthorized>
                    <RemoteAuthenticatorView Action="RemoteAuthenticationActions.LogIn" />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <Layouts.MainLayout>
                <div class="p-6 text-center text-muted-foreground">
                    <h1 class="text-2xl font-semibold">Page not found</h1>
                    <p class="mt-2 text-base">We couldn't find the screen you're looking for.</p>
                </div>
            </Layouts.MainLayout>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
